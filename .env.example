# On Vercel, mark these as Sensitive (runtime-only). The contact API reads them via
# dynamic process.env[key] so Next.js does not bake in undefined at build time.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Server-only — set in Vercel (Sensitive). Never use NEXT_PUBLIC_ for this key.
FOLLOW_UP_BOSS_API_KEY=
NEXT_PUBLIC_SITE_URL=https://lasvegasstriphighrises.com
BUILD_DATE_ISO=2026-05-12T00:00:00Z
# NAP phone for this site: 702-299-6607 (GBP Strip High-Rise location)
# Cloudflare Turnstile (optional). With both set, the contact form shows the
# challenge and /api/contact rejects posts without a valid token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
